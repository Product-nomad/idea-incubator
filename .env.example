# Copy to .env and fill in. Never commit the real .env.
TELEGRAM_BOT_TOKEN=put-your-bot-token-from-BotFather-here
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated Telegram numeric user IDs (get yours from @userinfobot).
AUTHORIZED_USERS=123456789
# Optional: override the Claude model.
# CLAUDE_MODEL=claude-opus-4-7
# Optional: where idea .md files are written + auto-pushed from. Should be a
# checkout of a (private) git repo. If unset, defaults to ./ideas/ alongside bot.py.
# IDEAS_DIR=/home/vpc/projects/idea-incubator-ideas
